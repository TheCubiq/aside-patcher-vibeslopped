{
  "schema_version": 1,
  "browser_version": "1.0.928.2",
  "targets": [
    "ask-aside",
    "bookmark-folder-appearance"
  ],
  "coverage": "Native folder expansion, menu contents, hover submenu and reset. Other acceptance cases remain pending.",
  "cases": [
    {
      "id": "baseline-color",
      "steps": [
        {
          "action": "count",
          "selector": {
            "class_name": "LabelButtonLabel",
            "text": "Ask Aside"
          },
          "expected": 0
        },
        {
          "action": "theme",
          "value": 2
        },
        {
          "action": "remember",
          "selector": {
            "class_name": "Label",
            "text": "Acceptance Parent"
          },
          "name": "--EnabledColor",
          "as": "parent-color"
        }
      ]
    },
    {
      "id": "light-theme-roundtrip",
      "steps": [
        {
          "action": "theme",
          "value": 1
        },
        {
          "action": "changed",
          "selector": {
            "class_name": "Label",
            "text": "Acceptance Parent"
          },
          "name": "--EnabledColor",
          "from": "parent-color"
        },
        {
          "action": "theme",
          "value": 2
        },
        {
          "action": "unchanged",
          "selector": {
            "class_name": "Label",
            "text": "Acceptance Parent"
          },
          "name": "--EnabledColor",
          "from": "parent-color"
        }
      ]
    },
