      "id": "rename-retains-appearance",
      "steps": [
        {
          "action": "bookmark",
          "method": "update",
          "arguments": [
            "12",
            {
              "title": "Renamed Nested"
            }
          ]
        },
        {
          "action": "unchanged",
          "selector": {
            "class_name": "Label",
            "text": "Renamed Nested"
          },
          "name": "--EnabledColor",
          "from": "nested-color"
