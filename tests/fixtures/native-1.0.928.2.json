      ]
    },
    {
      "id": "delete-recreate-no-inheritance",
      "steps": [
        {
          "action": "remember",
          "selector": {
            "class_name": "VerticalBookmarkRowView",
            "text": "Empty Folder"
          },
          "name": "Height",
          "as": "empty-height"
        },
        {
          "action": "bookmark",
          "method": "removeTree",
          "arguments": [
            "12"
          ]
        },
        {
          "action": "count",
          "selector": {
            "class_name": "VerticalBookmarkRowView",
            "text": "Renamed Nested"
          },
          "expected": 0
        },
        {
          "action": "bookmark",
          "method": "create",
          "arguments": [
            {
              "parentId": "21",
              "title": "Renamed Nested"
            }
          ]
        },
        {
          "action": "unchanged",
          "selector": {
            "class_name": "Label",
            "text": "Renamed Nested"
          },
          "name": "--EnabledColor",
          "from": "parent-color"
        },
        {
          "action": "unchanged",
          "selector": {
            "class_name": "VerticalBookmarkRowView",
            "text": "Renamed Nested"
          },
          "name": "Height",
          "from": "empty-height"
        }
      ]
    },
    {
      "id": "drag-reorder-folder",
      "steps": [
        {
          "action": "real-drag",
          "source": {
            "class_name": "VerticalBookmarkRowView",
            "text": "Same Name"
          },
          "target": {
            "class_name": "VerticalBookmarkRowView",
            "text": "Empty Folder"
          },
          "fraction": [
            0.05,
            0.5
          ],
          "edge": "before"
        },
        {
          "action": "bookmark-assert",
          "reference": {
            "id": "20"
          },
          "expected": {
            "parentId": "1",
            "index": 2
          }
        }
      ]
    },
    {
