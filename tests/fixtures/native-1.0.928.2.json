        {
          "action": "bookmark",
          "method": "update",
          "arguments": [
            "21",
            {
              "title": "Moved Parent"
            }
          ]
        },
        {
          "action": "bookmark",
          "method": "move",
          "arguments": [
            "12",
            {
              "parentId": "21"
            }
          ]
        },
        {
          "action": "click",
          "selector": {
            "class_name": "VerticalBookmarkRowView",
            "text": "Moved Parent"
          }
